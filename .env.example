# =============================================================================
# FoodBridge AI: environment configuration template
#
#   npm run setup          # creates .env from this file with generated secrets
#   (or) cp .env.example .env and replace every "replace-with-…" value
#
# Values here are placeholders or safe LOCAL-DEVELOPMENT defaults. Never
# commit .env. In production, supply secrets through your hosting platform's
# secret manager. The backend refuses to start with development-only values
# (EMAIL_PROVIDER=log, insecure cookies) in production.
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
NODE_ENV=development
# Display default when a user/organisation has no timezone. Storage is always UTC.
DEFAULT_DISPLAY_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# PostgreSQL + PostGIS (Docker, local development)
# -----------------------------------------------------------------------------
POSTGRES_DB=foodbridge
POSTGRES_TEST_DB=foodbridge_test
POSTGRES_USER=foodbridge
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-a-generated-password
# Host port. 5433 avoids clashing with a locally installed PostgreSQL on 5432.
POSTGRES_PORT=5433

DATABASE_URL=postgresql://foodbridge:replace-with-a-generated-password@localhost:5433/foodbridge
# Automated tests run only against a database whose name ends in "_test".
TEST_DATABASE_URL=postgresql://foodbridge:replace-with-a-generated-password@localhost:5433/foodbridge_test
DATABASE_POOL_MAX=10

# -----------------------------------------------------------------------------
# Backend API (Node.js / Express)
# -----------------------------------------------------------------------------
BACKEND_PORT=5001
# Comma-separated list of allowed browser origins (no "*" in production).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://localhost:4173,http://localhost:8080
# Public URL of the web app, used in links inside emails/invitations.
APP_BASE_URL=http://localhost:5173
# Set to true when running behind a reverse proxy / load balancer.
TRUST_PROXY=false
# Refresh-token cookie "Secure" flag. Defaults to true in production; leave
# empty locally (http://localhost) unless you serve over HTTPS.
COOKIE_SECURE=

# Authentication. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-generated-secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Shared secret between backend and AI service (must be identical in both).
# Generate: openssl rand -base64 48
INTERNAL_SERVICE_TOKEN=replace-with-a-generated-secret

# Private file storage for verification documents and representative photos.
# Defaults to <repo>/uploads (gitignored). Use a persistent volume in production.
UPLOAD_DIR=

# Background job worker (matching, notifications, expiry, retention, forecasts).
JOB_WORKER_ENABLED=true
RATE_LIMIT_ENABLED=true

# -----------------------------------------------------------------------------
# AI service (Python / FastAPI)
# -----------------------------------------------------------------------------
AI_SERVICE_PORT=8001
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT_MS=5000
AI_ASSISTANT_TIMEOUT_MS=45000

# LLM assistant provider: none | gemini | openai
# With "none" the assistant still answers suggested questions with direct,
# real data, and says plainly that the AI assistant is unavailable.
LLM_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# -----------------------------------------------------------------------------
# External integrations (all optional; features degrade with clear labelling)
# -----------------------------------------------------------------------------
# Google Maps Routes API (server key, backend only). Without it, distances are
# labelled straight-line estimates and ETAs are shown as unavailable.
GOOGLE_MAPS_SERVER_API_KEY=

# Email: none | smtp | log (log = DEVELOPMENT ONLY, writes emails to the backend log)
EMAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Razorpay. Online payments are enabled only when all three are set; otherwise
# invoices stay payable and admins can record manual (offline) payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Data retention
# -----------------------------------------------------------------------------
LOCATION_RETENTION_DAYS=30
AI_INTERACTION_RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# Frontend (Vite). Only VITE_* variables reach the browser: never put secrets here.
# In development the Vite dev server proxies /api and /socket.io to the backend,
# so the defaults below can stay empty (same-origin).
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=
VITE_SOCKET_URL=
# Optional browser key (restrict it to your domains). Without it, maps use OpenStreetMap.
VITE_GOOGLE_MAPS_BROWSER_API_KEY=
