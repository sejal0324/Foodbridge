# =============================================================================
# FoodBridge AI: environment configuration template
#
#   cp .env.example .env    # then fill in values. Never commit .env.
#
# Values in this file are placeholders only. Every secret must be generated
# locally (see the commands next to each one) or supplied by your hosting
# platform's secret manager in production.
#
# Variables marked (Phase N) are read only once that phase is implemented.
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
NODE_ENV=development
# Timezone used when a user/organisation has none configured. All timestamps
# are stored in UTC; this only affects display defaults.
DEFAULT_DISPLAY_TIMEZONE=Asia/Kolkata

# -----------------------------------------------------------------------------
# PostgreSQL + PostGIS (Docker, local development)
# -----------------------------------------------------------------------------
POSTGRES_DB=foodbridge
POSTGRES_TEST_DB=foodbridge_test
POSTGRES_USER=foodbridge
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-a-generated-password
# Host port. 5433 avoids clashing with a locally installed PostgreSQL on 5432.
POSTGRES_PORT=5433

DATABASE_URL=postgresql://foodbridge:replace-with-a-generated-password@localhost:5433/foodbridge
TEST_DATABASE_URL=postgresql://foodbridge:replace-with-a-generated-password@localhost:5433/foodbridge_test

# -----------------------------------------------------------------------------
# Backend API (Node.js / Express): Phase 1+
# -----------------------------------------------------------------------------
BACKEND_PORT=5001
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# Authentication (Phase 2)
# Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-generated-secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Pickup verification (Phase 7)
# Pepper used to HMAC one-time passwords before storage. Generate: openssl rand -base64 48
OTP_HMAC_SECRET=replace-with-a-generated-secret
# Development-only OTP delivery that writes codes to the backend log.
# The backend refuses to start if this is true while NODE_ENV=production.
OTP_DEV_MODE=false

# Internal service-to-service authentication between backend and AI service.
# Must be identical in both services. Generate: openssl rand -base64 48
INTERNAL_SERVICE_TOKEN=replace-with-a-generated-secret

# -----------------------------------------------------------------------------
# AI service (Python / FastAPI): Phase 5+
# -----------------------------------------------------------------------------
AI_SERVICE_PORT=8001
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT_MS=5000

# LLM assistant (Phase 6). Provider: none | gemini | openai
# With "none" the assistant reports that it is unavailable; the rest of the
# platform keeps working.
LLM_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# -----------------------------------------------------------------------------
# External integrations (all optional; features degrade with clear labelling)
# -----------------------------------------------------------------------------
# Google Maps server key (Routes API / Geocoding), used by the backend only.
GOOGLE_MAPS_SERVER_API_KEY=

# Email delivery (Phase 3+). Provider: none | smtp
EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# SMS delivery for pickup OTPs (Phase 7). Provider: none | <to be chosen>
SMS_PROVIDER=none

# Razorpay (Phase 9). Real payments are enabled only when all three are set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Data retention
# -----------------------------------------------------------------------------
LOCATION_RETENTION_DAYS=30
AI_INTERACTION_RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# Frontend (Vite). Only VITE_* variables are exposed to the browser:
# never put secrets in them.
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5001/api
VITE_SOCKET_URL=http://localhost:5001
# Browser key: restrict it to your domains in Google Cloud Console.
VITE_GOOGLE_MAPS_BROWSER_API_KEY=
